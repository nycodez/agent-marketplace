{
  "name": "agent-marketplace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "dev:clean": "docker compose down -v",
    "dev:logs": "docker compose logs -f web api worker temporal temporal-ui postgres redis",
    "db:migrate": "pnpm --filter @agent-marketplace/database migrate",
    "db:migrate:status": "pnpm --filter @agent-marketplace/database migrate:status",
    "db:migrate:create": "pnpm --filter @agent-marketplace/database migrate:create",
    "dev:web": "pnpm --filter @agent-marketplace/web dev",
    "dev:api": "pnpm --filter @agent-marketplace/api dev",
    "dev:worker": "pnpm --filter @agent-marketplace/worker dev",
    "test": "vitest run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
